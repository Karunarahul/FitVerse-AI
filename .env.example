# ====================================================================
# FITVERSE AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# --------------------------------------------------------------------
# 1. CLIENT CONFIGURATION (Expo Public — Bundled in Mobile Client)
# --------------------------------------------------------------------
# Base URL for the FitVerse AI backend service.
# For local physical device testing, use your machine's LAN IP (e.g. http://192.168.1.100:3001)
# For web or emulator: http://localhost:3001
# For production: https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Real Supabase Project URL and Anon (Public) Key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development demo bypass (MUST be false in production)
EXPO_PUBLIC_DEMO_MODE=false

# --------------------------------------------------------------------
# 2. SERVER CONFIGURATION (Backend Only — NEVER Exposed to Client)
# --------------------------------------------------------------------
PORT=3001

# Google Gemini AI (Primary Intelligence Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Fallback Intelligence Engine)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=o1-mini

# Supabase Service Role Key (Admin operations like permanent user deletion)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
